	measure 'Último Valor Percentual' =
			
			VAR UltimaData =
			    MAXX(
			        FILTER(
			            ALLSELECTED(dim_calendario[data]),
			            NOT ISBLANK(CALCULATE([Mediana Mercado]))
			        ),
			        dim_calendario[data]
			    )
			RETURN
			    IF(
			        SELECTEDVALUE(dim_calendario[data]) = UltimaData,
			        FORMAT([Mediana Mercado], "0.00", "pt-BR") & "%",
			        BLANK()
			    )
		lineageTag: 09bc5b95-170a-4c17-8411-9319affad7d8

	measure 'Data Início Destaque' =
			
			VAR DatasComValor =
			    FILTER(
			        ALLSELECTED(dim_calendario[data]),
			        NOT ISBLANK(CALCULATE([Mediana Mercado]))
			    )
			VAR UltimaData =
			    MAXX(DatasComValor, dim_calendario[data])
			VAR DataCorte = UltimaData - 30
			RETURN
			    COALESCE(
			        MAXX(
			            FILTER(
			                DatasComValor,
			                dim_calendario[data] <= DataCorte
			            ),
			            dim_calendario[data]
			        ),
			        MINX(DatasComValor, dim_calendario[data])
			    )
		formatString: General Date
		lineageTag: 8e252618-ea23-49d3-b75f-ffd3e5a8f209

	measure 'Mediana Histórico' =
			
			VAR DataAtual = SELECTEDVALUE(dim_calendario[data])
			VAR DataInicio = [Data Início Destaque]
			RETURN
			    IF(
			        NOT ISBLANK(DataInicio)
			            && DataAtual <= DataInicio,
			        [Mediana Mercado],
			        BLANK()
			    )
		lineageTag: f95f0447-1b43-4ac8-8a5c-1e589eab1c3a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Mediana Recente' =
			
			VAR DataAtual = SELECTEDVALUE(dim_calendario[data])
			VAR DataInicio = [Data Início Destaque]
			RETURN
			    IF(
			        NOT ISBLANK(DataInicio)
			            && DataAtual >= DataInicio,
			        [Mediana Mercado],
			        BLANK()
			    )
		lineageTag: 89a587e4-ff82-4a8b-9ac1-9ee255afe280

		annotation PBI_FormatHint = {"isGeneralNumber":true}

