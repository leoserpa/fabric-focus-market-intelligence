	measure 'Última Data Focus' =
			
			CALCULATE(
			    MAX(fct_expectativas_mercado[data]),
			    REMOVEFILTERS(dim_calendario[data])
			)
		formatString: General Date
		lineageTag: f4b608ef-899a-4d91-97f8-ba429215a401

	measure 'HTML Observação Mais Recente' =
			
			VAR DataObs =
			    CALCULATE(
			        MAX(fct_expectativas_mercado[data]),
			        REMOVEFILTERS(dim_calendario[data])
			    )
			VAR TextoData =
			    IF(
			        ISBLANK(DataObs),
			        "Sem dados",
			        FORMAT(DataObs, "dd/MM/yyyy")
			    )
			RETURN
			    "<div style='width:100%;height:100%;min-height:56px;box-sizing:border-box;display:flex;align-items:center;" &
			        "gap:12px;padding:0 18px;border:1px solid #CBD2D5;border-radius:7px;background:#FFFFFF;" &
			        "font-family:Segoe UI,Arial,sans-serif;font-size:15px;color:#626E73;white-space:nowrap;'>" &
			        "<span style='font-size:18px;color:#626E73;'>▦</span>" &
			        "<span>Observação mais recente</span>" &
			        "<strong style='font-size:15px;font-weight:700;color:#23282B;'>" & TextoData & "</strong>" &
			    "</div>"
		lineageTag: 050194b5-7b4e-414b-be34-7156fb96cc44

	measure 'KPI Última Mediana' =
			
			VAR DataMaisRecente =
			    CALCULATE(
			        MAX(fct_expectativas_mercado[data]),
			        REMOVEFILTERS(dim_calendario),
			        fct_expectativas_mercado[mediana] <> BLANK()
			    )
			RETURN
			    IF(
			        ISBLANK(DataMaisRecente),
			        BLANK(),
			        CALCULATE(
			            [Mediana Mercado],
			            REMOVEFILTERS(dim_calendario),
			            fct_expectativas_mercado[data] = DataMaisRecente
			        )
			    )
		lineageTag: 546d3f33-5e97-4a16-8435-50deae9ddb6a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'KPI IPCA 2026' =
			
			CALCULATE(
			    [KPI Última Mediana],
			    fct_expectativas_mercado[indicador] = "IPCA",
			    fct_expectativas_mercado[ano_referencia] = 2026,
			    fct_expectativas_mercado[base_calculo] = 0
			)
		lineageTag: 43c880a9-997a-4cd0-886e-adfdb9f510f3

